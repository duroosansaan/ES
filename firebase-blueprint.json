{
  "entities": {
    "OrderRequest": {
      "title": "OrderRequest",
      "description": "Client order requests and leads submitted through the website",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique record identifier" },
        "clientName": { "type": "string", "description": "Full name or business name of client", "minLength": 1, "maxLength": 150 },
        "phone": { "type": "string", "description": "Contact phone number or WhatsApp", "minLength": 5, "maxLength": 30 },
        "orderDetails": { "type": "string", "description": "Detailed requirements of the project", "minLength": 1, "maxLength": 3000 },
        "budget": { "type": "string", "description": "Estimated budget", "maxLength": 100 },
        "notes": { "type": "string", "description": "Optional notes or deadline", "maxLength": 1000 },
        "status": { "type": "string", "enum": ["new", "contacted", "in_progress", "completed"], "description": "Order processing status" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" }
      },
      "required": ["clientName", "orderDetails", "createdAt"]
    }
  },
  "firestore": {
    "/orders/{orderId}": {
      "schema": "OrderRequest",
      "description": "Collection of client orders and service requests"
    }
  }
}
